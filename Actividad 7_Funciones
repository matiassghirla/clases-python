# Deber

def promedio(n1, n2, n3):
    resultado = (n1 + n2 + n3) / 3
    return resultado

def nota_mayor(n1, n2, n3):

    if n1 >= n2 and n1 >= n3:
        return n1

    elif n2 >= n1 and n2 >= n3:
        return n2

    else:
        return n3

def nota_menor(n1, n2, n3):

    if n1 <= n2 and n1 <= n3:
        return n1

    elif n2 <= n1 and n2 <= n3:
        return n2

    else:
        return n3

def estado(prom):

    if prom >= 7:
        return "Aprueba"

    else:
        return "Reprueba"


# Programa principal

nota1 = float(input("Ingrese la primera nota: "))
