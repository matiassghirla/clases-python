#FOR Anidado

for fila in range(1, 4):

    for computadora in range(1, 5):

        nombre = input("Ingrese el nombre del estudiante: ")

        print(nombre, "asignado a Fila", fila,
              "- Computadora", computadora)

    print("Fin de la fila", fila)






